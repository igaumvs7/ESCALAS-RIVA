# URL e chave de SERVICE ROLE do mesmo projeto Supabase do VIVAS CONNECT.
# NUNCA a anon key - o worker precisa bypassar RLS (mexe em dados de todas
# as orgs que ativaram o canal gratis).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: caminho do Chrome/Chromium ja instalado no servidor. Se vazio,
# usa o Chromium que o Puppeteer baixa sozinho na instalacao (mais pesado,
# mas nao exige nada pre-instalado).
CHROME_PATH=
