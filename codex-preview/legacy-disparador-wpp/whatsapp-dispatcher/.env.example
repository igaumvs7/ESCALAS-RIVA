# Porta do servidor do painel
PORT=3333

# Usuario e senha para acessar o painel web (protecao basica)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=troque-esta-senha

# Caminho do executavel do Chrome/Chromium, caso queira usar um ja instalado
# na maquina em vez de deixar o Puppeteer baixar o dele.
# Ex: /usr/bin/google-chrome  ou  /opt/pw-browsers/chromium
CHROME_PATH=
